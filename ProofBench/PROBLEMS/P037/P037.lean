import Mathlib.Combinatorics.SimpleGraph.Cayley
import Mathlib.Combinatorics.SimpleGraph.Ends.Defs
import Mathlib.GroupTheory.Nilpotent
import Mathlib.Tactic.TFAE
import ProofBench.Mathlib_Problems.Combinatorics.SimpleGraph.Ball

open Subgroup SimpleGraph

universe u

variable (Γ : Type*) [Group Γ]

/-- The closed neighborhood of a vertex: the vertex together with its neighbors. -/
def closedNeighborSet {V : Type u} (G : SimpleGraph V) (v : V) : Set V :=
  insert v (G.neighborSet v)

/-- A graph covering map: a surjective homomorphism mapping the closed neighbourhood of each
vertex `x` bijectively onto the closed neighbourhood of `p x`. -/
def IsGraphCoveringMap {V W : Type u} (H : SimpleGraph W) (G : SimpleGraph V)
    (p : H →g G) : Prop :=
  Function.Surjective p ∧
    ∀ x : W, Set.BijOn p (closedNeighborSet H x) (closedNeighborSet G (p x))

/-- There is a walk of length at most `r` from `a` to `b`. -/
def HasWalkLengthAtMost {V : Type u} (G : SimpleGraph V) (a b : V) (r : ℕ) : Prop :=
  ∃ w : G.Walk a b, w.length ≤ r

/-- A walk in the ball `B_r(center, G)` with the vertex set `deleted` removed: its vertices lie
in the ball and outside `deleted`, and its edges lie in the ball. -/
def WalkInLocalBallAvoiding {V : Type u} (G : SimpleGraph V) (r : ℕ)
    (center : V) (deleted : Set V) {a b : V} (w : G.Walk a b) : Prop :=
  (∀ v : V, v ∈ w.support → IsInLocalBall G r center v ∧ v ∉ deleted) ∧
    ∀ e : Sym2 V, e ∈ w.edges → IsEdgeInLocalBall G r center e

/-- Two vertices are connected in `B_r(center, G) - deleted`. -/
def LocalBallConnectedAvoiding {V : Type u} (G : SimpleGraph V) (r : ℕ)
    (center : V) (deleted : Set V) (a b : V) : Prop :=
  ∃ w : G.Walk a b, WalkInLocalBallAvoiding G r center deleted w

/-- `v` is an `r`-local cutvertex: two vertices of the ball `B_r(v, G)` other than `v` are not
connected in `B_r(v, G) - v`. -/
def IsRLocalCutvertex {V : Type u} (G : SimpleGraph V) (r : ℕ) (v : V) : Prop :=
  ∃ a b : V,
    IsInLocalBall G r v a ∧ IsInLocalBall G r v b ∧
      a ≠ v ∧ b ≠ v ∧ ¬ LocalBallConnectedAvoiding G r v ({v} : Set V) a b

/-- `a` lies in the neighbourhood `N({v₀, v₁})`: it differs from `v₀`, `v₁` and is adjacent to
one of them. -/
def PairNeighbourhood {V : Type u} (G : SimpleGraph V) (v₀ v₁ a : V) : Prop :=
  a ≠ v₀ ∧ a ≠ v₁ ∧ (G.Adj v₀ a ∨ G.Adj v₁ a)

/-- Adjacency in the connectivity graph `C_r(v₀, v₁, G)` (Definition 5.1 of
Carmesin–Kontogeorgiou–Kurkofka–Turner): two vertices of `N({v₀, v₁})` that are connected in
`B_r(vᵢ, G) - v₀ - v₁` for some `i`. -/
def LocalConnectivityGraphAdj {V : Type u} (G : SimpleGraph V) (r : ℕ)
    (v₀ v₁ a b : V) : Prop :=
  PairNeighbourhood G v₀ v₁ a ∧ PairNeighbourhood G v₀ v₁ b ∧
    (LocalBallConnectedAvoiding G r v₀ ({v₀, v₁} : Set V) a b ∨
      LocalBallConnectedAvoiding G r v₁ ({v₀, v₁} : Set V) a b)

/-- Reachability in the connectivity graph `C_r(v₀, v₁, G)`. -/
def LocalConnectivityGraphReachable {V : Type u} (G : SimpleGraph V) (r : ℕ)
    (v₀ v₁ a b : V) : Prop :=
  Relation.ReflTransGen (LocalConnectivityGraphAdj G r v₀ v₁) a b

/-- `{v₀, v₁}` is an `r`-local 2-separator (Definition 5.1 of
Carmesin–Kontogeorgiou–Kurkofka–Turner): `C_r(v₀, v₁, G)` is disconnected and
`dist(v₀, v₁) ≤ r/2`. -/
def IsRLocalTwoSeparator {V : Type u} (G : SimpleGraph V) (r : ℕ)
    (v₀ v₁ : V) : Prop :=
  v₀ ≠ v₁ ∧ HasWalkLengthAtMost G v₀ v₁ (r / 2) ∧
    ∃ a b : V,
      PairNeighbourhood G v₀ v₁ a ∧ PairNeighbourhood G v₀ v₁ b ∧
        ¬ LocalConnectivityGraphReachable G r v₀ v₁ a b

/-- `X` is an `r`-local separator of size at most two: an `r`-local cutvertex or an `r`-local
2-separator. -/
def IsRLocalSeparatorAtMostTwo {V : Type u} (G : SimpleGraph V) (r : ℕ)
    (X : Finset V) : Prop :=
  X.card ≤ 2 ∧
    ((∃ v : V, (X : Set V) = {v} ∧ IsRLocalCutvertex G r v) ∨
      ∃ v₀ v₁ : V,
        v₀ ≠ v₁ ∧ (X : Set V) = {v₀, v₁} ∧ IsRLocalTwoSeparator G r v₀ v₁)

/-- Two walks with the same ends are `r`-homotopic if they are related by the equivalence relation
generated by inserting a closed walk of length at most `r` at a vertex of a walk. For `r ≥ 2`, a
closed walk at `x` is `r`-homotopic to the trivial walk iff its class lies in `π₁ʳ(G, x)`, the
subgroup of `π₁(G, x)` generated by the walks `W Q W⁻¹` with `Q` closed of length at most `r`. -/
def AreRHomotopic {V : Type u} (G : SimpleGraph V) (r : ℕ) {x y : V}
    (w₁ w₂ : G.Walk x y) : Prop :=
  Relation.EqvGen
    (fun w w' : G.Walk x y => ∃ (z : V) (a : G.Walk x z) (c : G.Walk z z) (b : G.Walk z y),
      c.length ≤ r ∧ w = a.append b ∧ w' = a.append (c.append b))
    w₁ w₂

/-- For `r ≥ 2`, `p` is the `r`-local covering `G_r → G` (characteristic subgroup `π₁ʳ(G)`, §4 of
arXiv:2207.04855), up to equivalence: a covering map with connected cover, distinct lifts of a
vertex at distance `> r` (closed walks of length `≤ r` lift to closed walks), and every closed walk
of the cover `r`-homotopic to the trivial walk. -/
def IsRLocalCovering {V W : Type u} (H : SimpleGraph W) (G : SimpleGraph V) (p : H →g G)
    (r : ℕ) : Prop :=
  IsGraphCoveringMap H G p ∧ H.Connected ∧
    (∀ x y : W, HasWalkLengthAtMost H x y r → p x = p y → x = y) ∧
    ∀ (x : W) (w : H.Walk x x), AreRHomotopic H r w Walk.nil

/-- The component of `G - K` selected by the end `e`. -/
def endComponentAt {V : Type u} (G : SimpleGraph V) (K : Finset V)
    (e : G.end) : G.ComponentCompl K :=
  (e : (j : (Finset V)ᵒᵖ) → G.componentComplFunctor.obj j) (Opposite.op K)

/-- Two ends of `G` select different components of `G - K`. -/
def EndsSeparatedBy {V : Type u} (G : SimpleGraph V) (K : Finset V) : Prop :=
  ∃ e₁ e₂ : G.end,
    e₁ ≠ e₂ ∧ endComponentAt G K e₁ ≠ endComponentAt G K e₂

/-- `K` has at most two vertices and separates two ends of `G`. -/
def HasTwoEndsSeparatedByAtMostTwo {V : Type u} (G : SimpleGraph V)
    (K : Finset V) : Prop :=
  K.card ≤ 2 ∧ EndsSeparatedBy G K

/-- An `r`-local separator of `G` of size at most two. -/
structure LocalSeparator {V : Type u} (G : SimpleGraph V) (r : ℕ) : Type u where
  separator : Finset V
  is_local_separator : IsRLocalSeparatorAtMostTwo G r separator

/-- The `r`-local covering of `G`, together with a set of at most two vertices of the covering
graph separating two of its ends. -/
structure LocalCovering {V : Type u} (G : SimpleGraph V) (r : ℕ) : Type (u + 1) where
  W : Type u
  coverGraph : SimpleGraph W
  projection : coverGraph →g G
  is_local_covering : IsRLocalCovering coverGraph G projection r
  separator : Finset W
  ends_separated : HasTwoEndsSeparatedByAtMostTwo coverGraph separator

/-- Assertion (i) of Theorem 1: the `r`-local covering of some Cayley graph of `Γ` has two ends
separated by at most two vertices. -/
def AssertionI (r : ℕ) : Prop :=
  ∃ S : Set Γ, closure S = ⊤ ∧
    Nonempty (LocalCovering (mulCayley S) r)

/-- Assertion (ii) of Theorem 1: some Cayley graph of `Γ` has an `r`-local separator of size at
most two, and `Γ` has order greater than `r`. -/
def AssertionII [Finite Γ] (r : ℕ) : Prop :=
  (∃ S : Set Γ, closure S = ⊤ ∧ Nat.card Γ > r ∧
      Nonempty (LocalSeparator (mulCayley S) r))

/-- Assertion (iii) of Theorem 1: `Γ ≅ C_i × C_j` for some `i > r` and `j ∈ {1, 2}`, with the
cyclic group `C_k` taken as `Multiplicative (ZMod k)`. -/
def AssertionIII (r : ℕ) : Prop :=
  ∃ i j : ℕ,
    i > r ∧ j ∈ ({1, 2} : Finset ℕ) ∧
      Nonempty (Γ ≃* (Multiplicative (ZMod i) × Multiplicative (ZMod j)))

/-- Theorem 1 of Carmesin–Kontogeorgiou–Kurkofka–Turner, arXiv:2403.07776: for a finite group
`Γ`, nilpotent of class at most `n`, and `r ≥ max {4^(n+1), 20}`, assertions (i), (ii) and (iii)
are equivalent. -/
theorem P037
    [Finite Γ] [Group.IsNilpotent Γ]
    {n r : ℕ}
    (hclass : Group.nilpotencyClass Γ ≤ n)
    (hr : max (4 ^ (n + 1)) 20 ≤ r) :
    [AssertionI Γ r, AssertionII Γ r, AssertionIII Γ r].TFAE := by sorry
