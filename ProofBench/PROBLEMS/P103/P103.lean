import ProofBench.Mathlib_Problems.Combinatorics.SimpleGraph.RandomGraphs
import Mathlib.Combinatorics.SimpleGraph.Basic
import Mathlib.Logic.Relation
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Tactic

noncomputable section

namespace RandomGraphOrderDimension

/-- The forward edges of `G`: `i < j` in the natural order of `[n]` and `ij` is an edge. -/
def orientedAdj {n : Nat} (G : SimpleGraph (Fin n)) (i j : Fin n) : Prop :=
  i < j /\ G.Adj i j

/-- The graph order `P_G`: the reflexive transitive closure of the forward edges of `G`. -/
def graphOrderLE {n : Nat} (G : SimpleGraph (Fin n)) : Fin n -> Fin n -> Prop :=
  Relation.ReflTransGen (orientedAdj G)

/-- The graph order is reflexive. -/
theorem graphOrderLE_refl {n : Nat} (G : SimpleGraph (Fin n)) (i : Fin n) :
    graphOrderLE G i i :=
  Relation.ReflTransGen.refl

/-- The graph order is transitive. -/
theorem graphOrderLE_trans {n : Nat} (G : SimpleGraph (Fin n))
    {i j k : Fin n} :
    graphOrderLE G i j -> graphOrderLE G j k -> graphOrderLE G i k :=
  Relation.ReflTransGen.trans

/-- Every comparison generated by an increasing graph path respects the
ambient natural order. -/
theorem graphOrderLE_le {n : Nat} {G : SimpleGraph (Fin n)} {i j : Fin n}
    (h : graphOrderLE G i j) : i <= j := by
  have h' : Relation.ReflTransGen ((fun a b : Fin n => a <= b)) i j :=
    h.lift id (fun _ _ edge => edge.1.le)
  simpa only [Relation.reflTransGen_eq_self] using h'

/-- The graph order is antisymmetric. -/
theorem graphOrderLE_antisymm {n : Nat} (G : SimpleGraph (Fin n))
    {i j : Fin n} (hij : graphOrderLE G i j)
    (hji : graphOrderLE G j i) : i = j :=
  le_antisymm (graphOrderLE_le hij) (graphOrderLE_le hji)

/-- Every forward graph edge is a comparison in the generated order. -/
theorem graphOrderLE_of_adj {n : Nat} {G : SimpleGraph (Fin n)}
    {i j : Fin n} (hij : i < j) (hadj : G.Adj i j) :
    graphOrderLE G i j :=
  Relation.ReflTransGen.single ⟨hij, hadj⟩

/-- In the complete graph, the generated graph order is exactly the natural
linear order. -/
theorem graphOrderLE_top_iff {n : Nat} {i j : Fin n} :
    graphOrderLE (⊤ : SimpleGraph (Fin n)) i j <-> i <= j := by
  constructor
  · exact graphOrderLE_le
  · intro hij
    rcases hij.eq_or_lt with hij | hij
    · subst j
      exact graphOrderLE_refl _ _
    · exact graphOrderLE_of_adj hij (by simp [hij.ne])

/-- A total order extending a specified partial-order relation. -/
structure LinearExtension {α : Type*} (leP : α -> α -> Prop) where
  le : α -> α -> Prop
  refl : forall x, le x x
  trans : forall {x y z}, le x y -> le y z -> le x z
  antisymm : forall {x y}, le x y -> le y x -> x = y
  total : forall x y, le x y \/ le y x
  le_of_leP : forall {x y}, leP x y -> le x y

/-- A family of `k` linear extensions realizes a partial order if their
intersection is precisely the original relation. -/
structure Realizer {α : Type*} (leP : α -> α -> Prop) (k : Nat) where
  orders : Fin k -> LinearExtension leP
  reflects : forall x y, (forall i, (orders i).le x y) -> leP x y

/-- The order has dimension at most `k` when it has a realizer of size `k`. -/
def HasDimensionAtMost {α : Type*} (leP : α -> α -> Prop) (k : Nat) : Prop :=
  Nonempty (Realizer leP k)

/-- The natural order is a linear extension of the complete graph order. -/
def topGraphLinearExtension (n : Nat) :
    LinearExtension (graphOrderLE (⊤ : SimpleGraph (Fin n))) where
  le := fun i j => i <= j
  refl := le_refl
  trans := fun h h' => h.trans h'
  antisymm := fun h h' => le_antisymm h h'
  total := le_total
  le_of_leP := graphOrderLE_le

/-- The order of the complete graph has dimension at most one. -/
theorem completeGraphOrder_dimension_atMost_one (n : Nat) :
    HasDimensionAtMost (graphOrderLE (⊤ : SimpleGraph (Fin n))) 1 := by
  refine ⟨{
    orders := fun _ => topGraphLinearExtension n
    reflects := ?_
  }⟩
  intro i j h
  apply graphOrderLE_top_iff.2
  exact h 0

/-- The dimension of a partial order: the least size of a realiser (Section 1.1), with the
junk value `0` when no realiser exists (which never happens for a finite partial order). -/
def dimension {α : Type*} (leP : α → α → Prop) : ℕ :=
  sInf {k | HasDimensionAtMost leP k}

/-- The dimension is at most the size of any realiser. -/
theorem dimension_le_of_hasDimensionAtMost {α : Type*} {leP : α → α → Prop} {k : ℕ}
    (h : HasDimensionAtMost leP k) : dimension leP ≤ k :=
  Nat.sInf_le h

/-- If some realiser exists, there is one of size equal to the dimension. -/
theorem hasDimensionAtMost_dimension {α : Type*} {leP : α → α → Prop}
    (h : ∃ k, HasDimensionAtMost leP k) : HasDimensionAtMost leP (dimension leP) :=
  Nat.sInf_mem h

/-- A realiser with `k ≥ 1` orders padded to `k' ≥ k` orders is still a realiser. -/
theorem HasDimensionAtMost.mono {α : Type*} {leP : α → α → Prop} {k k' : ℕ} (hk : 0 < k)
    (hkk' : k ≤ k') (h : HasDimensionAtMost leP k) : HasDimensionAtMost leP k' := by
  obtain ⟨R⟩ := h
  refine ⟨{
    orders := fun i => R.orders ⟨i.val % k, Nat.mod_lt _ hk⟩
    reflects := fun x y hxy => R.reflects x y fun j => ?_ }⟩
  have hj := hxy ⟨j.val, lt_of_lt_of_le j.2 hkk'⟩
  have hmod : j.val % k = j.val := Nat.mod_eq_of_lt j.2
  simpa [hmod] using hj

/-- A graph on `Fin (2 * n)` is bipartite with parts `A` (the first `n` vertices) and `B`
(the last `n`) when every edge joins the two parts. -/
def IsBipartiteAB (n : ℕ) (G : SimpleGraph (Fin (2 * n))) : Prop :=
  ∀ i j, G.Adj i j → (i.val < n ∧ n ≤ j.val) ∨ (j.val < n ∧ n ≤ i.val)

/-- For a bipartite graph with parts `A < B`, the graph order is the bipartite order of
Section 1: `i ≤ j` iff `i = j`, or `i ∈ A`, `j ∈ B` and `ij` is an edge. -/
theorem graphOrderLE_bipartite_iff {n : ℕ} {G : SimpleGraph (Fin (2 * n))}
    (hG : IsBipartiteAB n G) {i j : Fin (2 * n)} :
    graphOrderLE G i j ↔ i = j ∨ (i.val < n ∧ n ≤ j.val ∧ G.Adj i j) := by
  constructor
  · intro h
    rcases Relation.ReflTransGen.cases_head h with rfl | ⟨b, hib, hbj⟩
    · exact Or.inl rfl
    · have hAB : i.val < n ∧ n ≤ b.val := by
        rcases hG i b hib.2 with hh | hh
        · exact hh
        · have := hib.1
          rw [Fin.lt_def] at this
          omega
      rcases Relation.ReflTransGen.cases_head hbj with rfl | ⟨c, hbc, -⟩
      · exact Or.inr ⟨hAB.1, hAB.2, hib.2⟩
      · exfalso
        rcases hG b c hbc.2 with hh | hh
        · omega
        · have := hbc.1
          rw [Fin.lt_def] at this
          omega
  · rintro (rfl | ⟨hi, hj, hadj⟩)
    · exact graphOrderLE_refl G i
    · exact graphOrderLE_of_adj (Fin.lt_def.mpr (by omega)) hadj

open SpecifiedDegreeEmbedding Filter Topology
open scoped ENNReal

/-- The edge probabilities of `B(n, n, p)` on `Fin (2 * n)`: `p` between the parts `A`
(the first `n` vertices) and `B` (the last `n`), and `0` inside a part. -/
def bipartiteMatrix (n : ℕ) (p : ℝ) : Matrix (Fin (2 * n)) (Fin (2 * n)) ℝ :=
  Matrix.of fun i j =>
    if (i.val < n ∧ n ≤ j.val) ∨ (j.val < n ∧ n ≤ i.val) then p else 0

/-- The random bipartite graph `B(n, n, p)`: every pair `(i, j) ∈ A × B` is an edge
independently with probability `p`, and there are no edges inside `A` or `B`. -/
def bipartiteRandomGraph (n : ℕ) (p : ℝ) : PMF (SimpleGraph (Fin (2 * n))) :=
  independentEdgeGraph (2 * n) (bipartiteMatrix n p)

/-- The dimension of the graph order of a graph on `Fin (2 * n)`; for a sample of
`B(n, n, p)` this is `dim P_{B(n,n,p)}`. -/
def bipartiteOrderDimension {n : ℕ} (G : SimpleGraph (Fin (2 * n))) : ℕ :=
  dimension (graphOrderLE G)

/-- **Theorem 9** of Gao–Kumar, arXiv:2504.19029, with `q = 1 - p` ("a.a.s.": with probability
tending to `1`): (a) if `q = O(1/n)` and `q = ω(1/n²)`, then a.a.s. `dim P_{B(n,n,p)} = Θ(n² q)`
and `n - dim P_{B(n,n,p)} = Ω(n)`; (b) if `q = ω(1/n)` and `q ≤ n^{-1+1/7}`, then a.a.s.
`dim P_{B(n,n,p)} = (1 - o(1)) n`. -/
theorem P103 :
    (∀ p : ℕ → ℝ, (∀ n, p n ∈ Set.Icc (0 : ℝ) 1) →
      (∃ C : ℝ, ∀ᶠ n : ℕ in atTop, 1 - p n ≤ C / n) →
      Tendsto (fun n : ℕ => (n : ℝ) ^ 2 * (1 - p n)) atTop atTop →
      (∃ c₁ c₂ : ℝ, 0 < c₁ ∧ 0 < c₂ ∧
        Tendsto (fun n : ℕ => (bipartiteRandomGraph n (p n)).toOuterMeasure
          {G | c₁ * (n : ℝ) ^ 2 * (1 - p n) ≤ (bipartiteOrderDimension G : ℝ) ∧
            (bipartiteOrderDimension G : ℝ) ≤ c₂ * (n : ℝ) ^ 2 * (1 - p n)}) atTop (𝓝 1)) ∧
      (∃ c : ℝ, 0 < c ∧
        Tendsto (fun n : ℕ => (bipartiteRandomGraph n (p n)).toOuterMeasure
          {G | (bipartiteOrderDimension G : ℝ) ≤ n - c * n}) atTop (𝓝 1))) ∧
    (∀ p : ℕ → ℝ, (∀ n, p n ∈ Set.Icc (0 : ℝ) 1) →
      Tendsto (fun n : ℕ => (n : ℝ) * (1 - p n)) atTop atTop →
      (∀ᶠ n : ℕ in atTop, 1 - p n ≤ (n : ℝ) ^ (-(1 : ℝ) + 1 / 7)) →
      ∀ ε : ℝ, 0 < ε →
        Tendsto (fun n : ℕ => (bipartiteRandomGraph n (p n)).toOuterMeasure
          {G | (1 - ε) * n ≤ (bipartiteOrderDimension G : ℝ) ∧
            (bipartiteOrderDimension G : ℝ) ≤ (1 + ε) * n}) atTop (𝓝 1)) := by
  sorry

/-- **Theorem 9(a)**: for `q = O(1/n)` and `q = ω(1/n²)`, a.a.s. `dim P_{B(n,n,p)} = Θ(n² q)`
and `n - dim P_{B(n,n,p)} = Ω(n)`. -/
theorem cosparse_bipartite_dimension_a (p : ℕ → ℝ) (hp : ∀ n, p n ∈ Set.Icc (0 : ℝ) 1)
    (hO : ∃ C : ℝ, ∀ᶠ n : ℕ in atTop, 1 - p n ≤ C / n)
    (hω : Tendsto (fun n : ℕ => (n : ℝ) ^ 2 * (1 - p n)) atTop atTop) :
    (∃ c₁ c₂ : ℝ, 0 < c₁ ∧ 0 < c₂ ∧
      Tendsto (fun n : ℕ => (bipartiteRandomGraph n (p n)).toOuterMeasure
        {G | c₁ * (n : ℝ) ^ 2 * (1 - p n) ≤ (bipartiteOrderDimension G : ℝ) ∧
          (bipartiteOrderDimension G : ℝ) ≤ c₂ * (n : ℝ) ^ 2 * (1 - p n)}) atTop (𝓝 1)) ∧
    (∃ c : ℝ, 0 < c ∧
      Tendsto (fun n : ℕ => (bipartiteRandomGraph n (p n)).toOuterMeasure
        {G | (bipartiteOrderDimension G : ℝ) ≤ n - c * n}) atTop (𝓝 1)) :=
  P103.1 p hp hO hω

/-- **Theorem 9(b)**: for `q = ω(1/n)` and `q ≤ n^{-1+1/7}`, a.a.s.
`dim P_{B(n,n,p)} = (1 - o(1)) n`. -/
theorem cosparse_bipartite_dimension_b (p : ℕ → ℝ) (hp : ∀ n, p n ∈ Set.Icc (0 : ℝ) 1)
    (hω : Tendsto (fun n : ℕ => (n : ℝ) * (1 - p n)) atTop atTop)
    (hle : ∀ᶠ n : ℕ in atTop, 1 - p n ≤ (n : ℝ) ^ (-(1 : ℝ) + 1 / 7)) {ε : ℝ} (hε : 0 < ε) :
    Tendsto (fun n : ℕ => (bipartiteRandomGraph n (p n)).toOuterMeasure
      {G | (1 - ε) * n ≤ (bipartiteOrderDimension G : ℝ) ∧
        (bipartiteOrderDimension G : ℝ) ≤ (1 + ε) * n}) atTop (𝓝 1) :=
  P103.2 p hp hω hle ε hε

end RandomGraphOrderDimension
