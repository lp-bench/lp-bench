import Mathlib.Algebra.BigOperators.Finsupp.Basic
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Order.Interval.Set.Basic
import ProofBench.Mathlib_Problems.Combinatorics.Multigraph.CycleDoubleCover

universe u

open scoped BigOperators

/-- A finite loopless weighted multigraph model of a compact metric graph. -/
structure MetricGraph where
  V : Type u
  E : Type u
  [instDecidableEqV : DecidableEq V]
  [instFintypeV : Fintype V]
  [instNonemptyV : Nonempty V]
  [instDecidableEqE : DecidableEq E]
  [instFintypeE : Fintype E]
  toMultigraph : Multigraph V E
  loopless : ∀ e, ¬toMultigraph.IsLoop e
  length : E → ℝ
  length_pos : ∀ e, 0 < length e

attribute [instance] MetricGraph.instDecidableEqV MetricGraph.instFintypeV
  MetricGraph.instNonemptyV MetricGraph.instDecidableEqE MetricGraph.instFintypeE

namespace MetricGraph

/-- The unordered endpoints of an edge. -/
def ends (G : MetricGraph) : G.E → Sym2 G.V :=
  G.toMultigraph.ends

/-- The first endpoint in a fixed representative of an unordered edge. -/
noncomputable def leftEnd (G : MetricGraph) (e : G.E) : G.V :=
  (G.ends e).out.1

/-- The second endpoint in a fixed representative of an unordered edge. -/
noncomputable def rightEnd (G : MetricGraph) (e : G.E) : G.V :=
  (G.ends e).out.2

/-- Connectivity of the underlying simple support graph. -/
def Connected (G : MetricGraph) : Prop :=
  G.toMultigraph.toSimpleGraph.Connected

/-- The genus, or cycle rank, of a connected metric graph model. -/
def genus (G : MetricGraph) : ℤ :=
  Fintype.card G.E - Fintype.card G.V + 1

/-- The points of a metric graph model: its vertices and the open interiors
of its edge occurrences. -/
abbrev Point (G : MetricGraph) :=
  G.V ⊕ Σ e : G.E, {x : ℝ // x ∈ Set.Ioo 0 (G.length e)}

end MetricGraph

/-- An integer divisor with finite support on the points of a metric graph. -/
abbrev MetricDiv (G : MetricGraph) := G.Point →₀ ℤ

/-- The coefficient of the divisor of a piecewise integral-affine function,
using the convention `-` the sum of its outgoing slopes. -/
noncomputable def metricOrderCoefficient (G : MetricGraph)
    (rightSlope leftSlope : G.E → ℝ → ℤ) : G.Point → ℤ
  | Sum.inl v =>
      ∑ e, ((if G.leftEnd e = v then -rightSlope e 0 else 0) +
        (if G.rightEnd e = v then leftSlope e (G.length e) else 0))
  | Sum.inr ⟨e, x⟩ => leftSlope e x - rightSlope e x

/-- A rational function on a metric graph: a continuous edgewise function
which is locally affine with integral one-sided slopes and has only finitely
many nonzero orders. -/
structure MetricRationalFunction (G : MetricGraph) where
  vertexValue : G.V → ℝ
  edgeValue : G.E → ℝ → ℝ
  value_zero : ∀ e, edgeValue e 0 = vertexValue (G.leftEnd e)
  value_length : ∀ e, edgeValue e (G.length e) = vertexValue (G.rightEnd e)
  rightSlope : G.E → ℝ → ℤ
  leftSlope : G.E → ℝ → ℤ
  affine_right : ∀ e x, x ∈ Set.Ico 0 (G.length e) →
    ∃ ε > 0, ∀ y ∈ Set.Icc x (min (G.length e) (x + ε)),
      edgeValue e y = edgeValue e x + (rightSlope e x : ℝ) * (y - x)
  affine_left : ∀ e x, x ∈ Set.Ioc 0 (G.length e) →
    ∃ ε > 0, ∀ y ∈ Set.Icc (max 0 (x - ε)) x,
      edgeValue e y = edgeValue e x + (leftSlope e x : ℝ) * (y - x)
  finite_orderSupport :
    (Function.support (metricOrderCoefficient G rightSlope leftSlope)).Finite
  order_degree_zero :
    (Finsupp.ofSupportFinite
      (metricOrderCoefficient G rightSlope leftSlope) finite_orderSupport).sum
        (fun _ n ↦ n) = 0

/-- The principal divisor of a rational function. -/
noncomputable def MetricRationalFunction.divisor {G : MetricGraph}
    (f : MetricRationalFunction G) : MetricDiv G :=
  Finsupp.ofSupportFinite
    (metricOrderCoefficient G f.rightSlope f.leftSlope) f.finite_orderSupport

/-- The subgroup generated by divisors of rational functions. -/
noncomputable def metricPrincipalDivisors (G : MetricGraph) : AddSubgroup (MetricDiv G) :=
  AddSubgroup.closure (Set.range fun f : MetricRationalFunction G ↦ f.divisor)

/-- Linear equivalence of divisors on a metric graph. -/
noncomputable def metricLinearEquiv (G : MetricGraph) (D E : MetricDiv G) : Prop :=
  E - D ∈ metricPrincipalDivisors G

/-- A metric-graph divisor is effective when all its coefficients are
nonnegative. -/
def metricEffective {G : MetricGraph} (D : MetricDiv G) : Prop :=
  ∀ p, 0 ≤ D p

/-- The degree of a metric-graph divisor. -/
def metricDegree {G : MetricGraph} : MetricDiv G →+ ℤ where
  toFun D := D.sum fun _ n ↦ n
  map_zero' := by simp
  map_add' D E := Finsupp.sum_add_index' (fun _ ↦ rfl) fun _ _ _ ↦ rfl
