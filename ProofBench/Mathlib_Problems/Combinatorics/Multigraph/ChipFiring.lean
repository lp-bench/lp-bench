import ProofBench.Mathlib_Problems.Combinatorics.Multigraph.CycleDoubleCover
import Mathlib.Algebra.Group.Subgroup.Finite

/-!
This minimal statement-layer API is adapted from the `CFGraph` model in
Dhyey Mavani and Nathan Pflueger's Apache-2.0-licensed
`chip-firing-with-lean` development, rebased on this project's shared
`Multigraph` so that chip-firing, cycle double covers and edge colourings
speak the same language.
-/

universe u

open scoped BigOperators

/-- A finite nonempty loopless multigraph over the shared `Multigraph`
model: `E` indexes the edges, so distinct indices with equal endpoints are
parallel edges. -/
structure CFGraph where
  V : Type u
  E : Type u
  [instDecidableEqV : DecidableEq V]
  [instFintypeV : Fintype V]
  [instNonemptyV : Nonempty V]
  [instDecidableEqE : DecidableEq E]
  [instFintypeE : Fintype E]
  toMultigraph : Multigraph V E
  loopless : ∀ e, ¬toMultigraph.IsLoop e

attribute [instance] CFGraph.instDecidableEqV CFGraph.instFintypeV
  CFGraph.instNonemptyV CFGraph.instDecidableEqE CFGraph.instFintypeE

/-- The multiplicity of the undirected edge between two vertices. -/
def num_edges (G : CFGraph) (v w : G.V) : ℕ :=
  (Finset.univ.filter fun e ↦ G.toMultigraph.ends e = s(v, w)).card

/-- Connectivity of the underlying simple graph. -/
def graph_connected (G : CFGraph) : Prop :=
  G.toMultigraph.toSimpleGraph.Connected

/-- The cycle rank `|E(G)| - |V(G)| + 1`. -/
def genus (G : CFGraph) : ℤ :=
  Fintype.card G.E - Fintype.card G.V + 1

/-- An integer-valued chip configuration on the vertices of `G`. -/
abbrev CFDiv (G : CFGraph) := G.V → ℤ

/-- The valence of a vertex, with parallel edges counted with multiplicity. -/
def vertex_degree (G : CFGraph) (v : G.V) : ℤ :=
  ∑ u, (num_edges G v u : ℤ)

/-- The change in chip configuration produced by firing `v` once. -/
def firing_vector (G : CFGraph) (v : G.V) : CFDiv G :=
  fun w ↦ if w = v then -vertex_degree G v else num_edges G v w

/-- The subgroup generated by all single-vertex firing vectors. -/
def principal_divisors (G : CFGraph) : AddSubgroup (CFDiv G) :=
  AddSubgroup.closure (Set.range (firing_vector G))

/-- Two chip configurations are linearly equivalent when their difference
is obtainable by chip-firing. -/
def linear_equiv (G : CFGraph) (D E : CFDiv G) : Prop :=
  E - D ∈ principal_divisors G

/-- A chip configuration is effective when it has no vertex in debt. -/
def effective {G : CFGraph} (D : CFDiv G) : Prop :=
  ∀ v, 0 ≤ D v

/-- The total number of chips in a configuration. -/
def deg {G : CFGraph} : CFDiv G →+ ℤ where
  toFun D := ∑ v, D v
  map_zero' := by simp
  map_add' D E := by simp [Finset.sum_add_distrib]
