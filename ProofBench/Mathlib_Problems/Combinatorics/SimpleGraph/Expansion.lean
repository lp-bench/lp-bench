import Mathlib.Combinatorics.SimpleGraph.Finite
import Mathlib.Combinatorics.SimpleGraph.Matching

universe u v

variable {V : Type u} [Fintype V]

/-- An `H`-**expansion** of a `|W|`-regular graph `G` (Kurkofka–Planken, §2): each vertex `v` of
`G` is replaced by a copy of `H` on the fibre `{v} × W`, every edge of `G` is realised by at least
one crossing edge, and crossing edges share no ends (each vertex has at most one neighbour outside
its own fibre). -/
structure HExpansion
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {W : Type v} [Fintype W] (H : SimpleGraph W)
    (hreg : G.IsRegularOfDegree (Fintype.card W)) : Type (max u v) where
  expandedGraph : SimpleGraph (V × W)
  fibre_graph :
    ∀ v : V, Nonempty (expandedGraph.induce {p : V × W | p.1 = v} ≃g H)
  cross_exists :
    ∀ ⦃u v : V⦄, G.Adj u v → ∃ w w' : W, expandedGraph.Adj (u, w) (v, w')
  cross_disjoint :
    ∀ ⦃p q q' : V × W⦄, q.1 ≠ p.1 → q'.1 ≠ p.1 →
      expandedGraph.Adj p q → expandedGraph.Adj p q' → q = q'

namespace HExpansion

variable {G : SimpleGraph V} [DecidableRel G.Adj]
variable {W : Type v} [Fintype W] {H : SimpleGraph W}
variable {hreg : G.IsRegularOfDegree (Fintype.card W)}
variable (X : HExpansion G H hreg)

/-- The crossing edges of an expansion, bundled as a spanning subgraph of the expanded graph. -/
def crossSubgraph : X.expandedGraph.Subgraph where
  verts := Set.univ
  Adj p q := p.1 ≠ q.1 ∧ X.expandedGraph.Adj p q
  adj_sub h := h.2
  edge_vert _ := Set.mem_univ _
  symm := ⟨fun {_ _} h => ⟨h.1.symm, h.2.symm⟩⟩

/-- The relation generating the expanded graph built from matching data `m`: a copy of `H`
inside each fibre, plus the single crossing edge `(u, m u v _)–(v, m v u _)` above every edge
`uv` of `G`. -/
def matchingRel (H : SimpleGraph W) (m : ∀ u v, G.Adj u v → W) (p q : V × W) : Prop :=
  (p.1 = q.1 ∧ H.Adj p.2 q.2) ∨
    ∃ h : G.Adj p.1 q.1, p.2 = m p.1 q.1 h ∧ q.2 = m q.1 p.1 h.symm

omit [Fintype V] [DecidableRel G.Adj] [Fintype W] in
/-- A crossing edge of the graph generated by `matchingRel` comes from an edge of `G`, with the
prescribed coordinates. -/
theorem matchingRel_cross {m : ∀ u v, G.Adj u v → W} {a c : V} {x y : W} (hne : c ≠ a)
    (h : (SimpleGraph.fromRel (matchingRel H m)).Adj (a, x) (c, y)) :
    ∃ hac : G.Adj a c, x = m a c hac ∧ y = m c a hac.symm := by
  rw [SimpleGraph.fromRel_adj] at h
  unfold matchingRel at h
  obtain ⟨-, (⟨heq, -⟩ | ⟨hac, hx, hy⟩) | (⟨heq, -⟩ | ⟨hca, hy, hx⟩)⟩ := h
  · exact absurd heq.symm hne
  · exact ⟨hac, hx, hy⟩
  · exact absurd heq hne
  · exact ⟨hca.symm, hx, hy⟩

variable (G H hreg) in
/-- Build an `H`-expansion from matching data: for every edge `uv` of `G`, the fibre coordinates
`m u v _` and `m v u _` of the ends of its crossing edge, injective in `v` at every vertex `u`. -/
def ofMatchingData (m : ∀ u v, G.Adj u v → W)
    (hm : ∀ u v v' (h : G.Adj u v) (h' : G.Adj u v'), m u v h = m u v' h' → v = v') :
    HExpansion G H hreg where
  expandedGraph := SimpleGraph.fromRel (matchingRel H m)
  fibre_graph v :=
    ⟨{ toFun := fun p => (p : V × W).2
       invFun := fun w => ⟨(v, w), rfl⟩
       left_inv := by rintro ⟨⟨a, b⟩, hp⟩; obtain rfl : a = v := hp; rfl
       right_inv := fun _ => rfl
       map_rel_iff' := by
         rintro ⟨⟨a, b⟩, hp⟩ ⟨⟨c, d⟩, hq⟩
         obtain rfl : a = c := hp.trans hq.symm
         change H.Adj b d ↔ (SimpleGraph.fromRel (matchingRel H m)).Adj (a, b) (a, d)
         rw [SimpleGraph.fromRel_adj]
         unfold matchingRel
         constructor
         · intro h
           exact ⟨fun hcon => H.ne_of_adj h (congrArg Prod.snd hcon), Or.inl (Or.inl ⟨rfl, h⟩)⟩
         · rintro ⟨-, (⟨-, h⟩ | ⟨haa, -⟩) | (⟨-, h⟩ | ⟨haa, -⟩)⟩
           · exact h
           · exact (G.irrefl haa).elim
           · exact h.symm
           · exact (G.irrefl haa).elim }⟩
  cross_exists := fun u v huv =>
    ⟨m u v huv, m v u huv.symm, by
      rw [SimpleGraph.fromRel_adj]
      exact ⟨fun hcon => huv.ne (congrArg Prod.fst hcon), Or.inl (Or.inr ⟨huv, rfl, rfl⟩)⟩⟩
  cross_disjoint := by
    rintro ⟨a, x⟩ ⟨c, y⟩ ⟨c', y'⟩ hne hne' hadj hadj'
    obtain ⟨h₁, hx₁, hy₁⟩ := matchingRel_cross hne hadj
    obtain ⟨h₂, hx₂, hy₂⟩ := matchingRel_cross hne' hadj'
    obtain rfl : c = c' := hm a c c' h₁ h₂ (hx₁.symm.trans hx₂)
    exact congrArg (Prod.mk c) (hy₁.trans hy₂.symm)

end HExpansion

/-- `Gexp` is an `H`-expansion of `G`: `G` is `|W|`-regular (this is part of the assertion) and
`Gexp` is the expanded graph of some `HExpansion`. -/
def IsExpansion {W : Type v} [Fintype W] (H : SimpleGraph W)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (Gexp : SimpleGraph (V × W)) : Prop :=
  ∃ (hreg : G.IsRegularOfDegree (Fintype.card W))
    (E : HExpansion G H hreg), E.expandedGraph = Gexp
